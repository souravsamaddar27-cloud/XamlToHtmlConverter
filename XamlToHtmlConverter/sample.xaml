<Grid>
	<Grid.RowDefinitions>
		<RowDefinition Height="Auto"/>
		<RowDefinition Height="*"/>
	</Grid.RowDefinitions>

	<Border Background="LightGray" Padding="10" Grid.Row="0">
		<TextBlock Margin="5">Application Header</TextBlock>
	</Border>

	<Grid Grid.Row="1">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="0" Margin="10">
			<TextBlock Margin="0,0,0,10">User Information</TextBlock>

			<TextBox Width="200" Margin="5"
                     Text="{Binding UserName}" />

			<CheckBox Margin="5"
                      Content="Remember Me"
                      IsChecked="{Binding RememberUser}" />

			<RadioButton Margin="5"
                         Content="Admin"
                         IsChecked="True" />

			<Button Width="120" Height="35" Margin="5"
                    Content="Submit" />
		</StackPanel>

		<StackPanel Grid.Column="1" Margin="10">
			<TextBlock Margin="0,0,0,10">Options</TextBlock>

			<ComboBox Width="150" Margin="5">
				<ComboBoxItem>Option 1</ComboBoxItem>
				<ComboBoxItem>Option 2</ComboBoxItem>
			</ComboBox>

			<ListBox Margin="5">
				<ListBoxItem>Item A</ListBoxItem>
				<ListBoxItem>Item B</ListBoxItem>
			</ListBox>

			<Image Source="logo.png" Width="100" Margin="10"/>
		</StackPanel>
	</Grid>
</Grid>